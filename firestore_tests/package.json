{
  "name": "firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Tests for ../firestore.rules, run against the Firebase Firestore emulator.",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:emulator": "firebase --config ../firebase.json emulators:exec --only firestore --project demo-feedback-review \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0"
  }
}
